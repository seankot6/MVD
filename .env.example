SECRET_KEY=замените-на-длинную-случайную-строку
EMAIL_USER=ваш@gmail.com
EMAIL_PASS=пароль-приложения-gmail
RECIPIENT_EMAIL=oktyabrsky28@gmail.com
SMTP_SERVER=smtp.gmail.com

# --- Почта на Render (обязательно, Gmail SMTP там не работает) ---
# 1. Зарегистрируйтесь на https://resend.com тем же email, что и RECIPIENT_EMAIL
#    (или подключите свой домен в Resend).
# 2. API Keys → Create API Key → скопируйте ключ:
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=onboarding@resend.dev
# Без Resend на Render письма об обращениях не уходят (обращение в базе сохраняется).
# Постоянный код для входа и регистрации сотрудника (email + пароль + код)
STAFF_ACCESS_CODE=ваш-служебный-код
# STAFF_SKIP_EMAIL_VERIFY=1
# ADMIN_RESET_KEY=придумайте-длинный-секрет

# Постоянная база на Render (иначе данные сбрасываются при перезапуске):
# DATABASE_URL=postgresql://user:pass@host/dbname

# Локально:
FLASK_ENV=development
FLASK_DEBUG=1

# На Render (продакшен):
# FLASK_ENV=production
# FLASK_DEBUG=0
# BEHIND_PROXY=1
# SESSION_COOKIE_SECURE=1
