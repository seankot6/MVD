# Скопируйте в .env и заполните перед публикацией в интернет

SECRET_KEY=замените-на-длинную-случайную-строку
EMAIL_USER=ваш@gmail.com
EMAIL_PASS=пароль-приложения-gmail

# Локальная разработка
FLASK_ENV=development
FLASK_DEBUG=1

# На сервере (продакшен)
# FLASK_ENV=production
# FLASK_DEBUG=0
# BEHIND_PROXY=1
# SESSION_COOKIE_SECURE=1
# APP_URL=https://ваш-сервис.onrender.com
